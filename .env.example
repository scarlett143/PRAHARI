ENVIRONMENT=development

POSTGRES_DB=prahari
POSTGRES_USER=prahari
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://prahari:change-this-local-password@db:5432/prahari

# Generate before any shared/deployed environment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo/research backend. liboqs is recommended for deployment-grade decapsulation.
PQC_BACKEND=kyber-py

REKEY_AFTER_MESSAGES=100
REKEY_AFTER_MINUTES=15
MAX_MESSAGE_BYTES=131072

# Optional Polygon Merkle anchoring. Leave blank to keep local verified batches only.
POLYGON_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=

# Optional quantum research integration.
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_quantum_platform
INSTALL_QUANTUM=0
INSTALL_BLOCKCHAIN=0

VITE_API_URL=http://localhost:8000
