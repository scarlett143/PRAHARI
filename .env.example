ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=prahari
POSTGRES_USER=prahari
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://prahari:change-this-local-password@db:5432/prahari

# Connection pool. Endpoints hold a long-lived WebSocket and only burst on REST,
# so concurrent database work stays far below the endpoint count.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED in production; the app refuses to start without it there.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Cryptography
# ---------------------------------------------------------------------------
# kyber-py is pure Python and NOT constant-time — research grade only.
# Use liboqs for anything deployed.
PQC_BACKEND=kyber-py

REKEY_AFTER_MESSAGES=100
REKEY_AFTER_MINUTES=15
MAX_MESSAGE_BYTES=131072

# ---------------------------------------------------------------------------
# Scale
# ---------------------------------------------------------------------------
# One socket per endpoint plus operator consoles. 0 disables the cap.
MAX_WEBSOCKET_CONNECTIONS=2000

# ---------------------------------------------------------------------------
# Optional: Polygon Merkle anchoring
# Leave blank to keep locally verifiable batches. No transaction hash is ever
# fabricated when these are unset.
# ---------------------------------------------------------------------------
POLYGON_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=
INSTALL_BLOCKCHAIN=0

# ---------------------------------------------------------------------------
# Optional: quantum research module (Qiskit Aer)
# ---------------------------------------------------------------------------
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_quantum_platform
INSTALL_QUANTUM=0

# ---------------------------------------------------------------------------
# Frontend (inlined at build time — must be the URL BROWSERS use)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional: aircraft bridge (docker compose --profile bridge up)
# ---------------------------------------------------------------------------
PRAHARI_API_URL=http://backend:8000
PRAHARI_CALLSIGN=
PRAHARI_ENROLLMENT_TOKEN=
PRAHARI_CHANNEL_ID=
# synthetic = no autopilot needed; sitl = real MAVLink from ArduPilot/PX4
PRAHARI_SOURCE=synthetic
PRAHARI_MAVLINK_DEVICE=udpin:0.0.0.0:14550
